generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String    @id @default(cuid())
  name        String
  email       String    @unique
  password    String

  bio         String?
  image       String?

  products    Product[]
  reviews     Review[]
}

model Product {
  id          String    @id @default(cuid())
  name        String
  description String
  price       Float
  image       String
  category    String

  sellerId    String
  seller      User      @relation(fields: [sellerId], references: [id])

  reviews     Review[]

  createdAt   DateTime  @default(now())
}

model Review {
  id          String    @id @default(cuid())

  rating      Int
  comment     String

  userId      String
  productId   String

  user        User      @relation(fields: [userId], references: [id])
  product     Product   @relation(fields: [productId], references: [id])

  createdAt   DateTime  @default(now())
}